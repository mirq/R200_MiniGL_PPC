# WarpOS MiniGL V19 PPC DLL using the direct R200 semantic frontend.
.DELETE_ON_ERROR:
CPU     ?= 604e
include Makefile.wos.gcc.common

OBJDIR  ?= obj/dll-r200
OUT     ?= bin/minigl_ppc_r200.dll
WARPELF ?= bin/minigl_ppc_r200.warpelf
PYTHON  ?= python3
M68K_CC ?= /opt/amiga/bin/m68k-amigaos-gcc
M68K_PREFIX ?= $(patsubst %gcc,%,$(M68K_CC))

R200_NATIVE_ROOT ?= $(CURDIR)/classic_68k/dev/MiniGL_Library_Source_Code
# CP emitter source. Radeon9200.chip 0.41 removed the record emitter from the
# driver tree; the consumer now owns it (vendored from p96-driver 9d17239).
R200_EMITTER_ROOT ?= $(CURDIR)/backend_r200/third_party/radeon3d/emit
# Native R200 build outputs are explicit so an A/B build never overwrites the
# classic tree's packaged library/import archive. Override all four together
# for an isolated stack (see docs/building.md).
R200_NATIVE_OBJDIR ?= $(R200_NATIVE_ROOT)/obj_gcc_dispatch_r200
R200_NATIVE_EXOBJDIR ?= $(R200_NATIVE_ROOT)/obj_gcc_examples_dispatch
R200_NATIVE_OUTDIR ?= $(R200_NATIVE_ROOT)/bin/dispatch-r200-gcc
R200_NATIVE_BINDIR ?= $(R200_NATIVE_ROOT)/bin
R200_NATIVE_IMPORTLIB ?= $(R200_NATIVE_ROOT)/lib/libminigl_dispatch.a
R200_NATIVE_IMPORT ?= $(R200_NATIVE_IMPORTLIB)
R200_NATIVE_LIBRARY ?= $(R200_NATIVE_OUTDIR)/minigl.library
R200_HOST ?= bin/minigl_ppc_host
# Set MGLPPC_HOST_TRACE=1 to build the host with DH2:wosbuild/mglppc_host.log
# stage/poll reporting enabled (diagnostic builds only -- the per-line
# Open/Seek/Write/Close logging and 2s console reports cost frame time).
MGLPPC_HOST_TRACE ?= 0
# Protocol deadlines still use the calibrated timebase; profiling is optional.
MGLPPC_PROFILE ?= 0
# Enables the per-line open/append/close trace logger
# (DH2:wosbuild/mglppc_client.log), readable while a client is still running.
MGLPPC_CLIENT_TRACE ?= 0
# CP surface-descriptor cache capacity (W-20 A/B: 16 / 64 / 128). The safe
# invalidation rules are independent of this value.
MGLPPC_CP_SLOTS ?= 128
# Mismatch submits per frame before state-batch expansion engages (Quake A/B;
# default 4 is the gears-tuned value).
MGLPPC_EXPAND_MIN ?= 4
# Live console reports are independent; quiet counters use the runtime glHint.
MGLPPC_AUTOREPORT ?= 0
# Use isolated OBJDIR and WARPELF paths per MGLPPC_PROFILE/MGLPPC_AUTOREPORT
# configuration: make does not track command-line flag changes.
# Completed-present interval histogram/top gaps; shutdown output only.
MGLPPC_PACING ?= 0
# Sleep counters only; no clock calls outside actual host idle sleeps.
MGLPPC_IDLE_DIAG ?= 0
# Timed hostdbg markers (SLOW/STALL/HB in DH2:hostdbg.log); costs EClock
# reads every host loop pass, so diagnostic builds only.
MGLPPC_HOST_DBG ?= 0
# Disable only in a separately named host build for lookup-cost comparisons.
MGLPPC_HOST_TARGET_CACHE ?= 1
R200_PACKAGE_DIR ?= bin/r200-package

R200_DIR       := backend_r200
R200_LIBRARY   := $(R200_DIR)/library
R200_CLIENT    := $(R200_DIR)/client
R200_INCLUDE   := $(R200_DIR)/include
# Consumer Radeon3D header root. Override this together with R200_EMITTER_ROOT
# to pin an A/B build to one driver worktree (for example /tmp/opencode/p96-flip).
R200_THIRDPARTY ?= $(R200_DIR)/third_party/radeon3d/include
R200_GENERATED := $(R200_DIR)/generated
R200_SYMBOLS   := $(R200_GENERATED)/r200_symbols.txt
R200_TABLE     := $(R200_GENERATED)/dispatch_table_abi3.c

COMMON_CFLAGS = $(WOS_ARCH_CFLAGS) -O2 -std=gnu99 -Wall \
                -fomit-frame-pointer -fno-common $(WOS_CPPFLAGS)
DLL_CFLAGS = $(COMMON_CFLAGS) -Iinclude -I$(R200_INCLUDE) \
             -I$(R200_LIBRARY) -Ihyperion_dll
R200_CFLAGS = $(COMMON_CFLAGS) -I$(R200_INCLUDE) -Iinclude \
              -I$(R200_LIBRARY) -I$(R200_THIRDPARTY) \
               -DNO_INLINE_LIBCALLS=1 -DR200_PPC_FRONTEND=1 \
               -DR200_FRONTEND_LIBRARY=1 -DR200_PERF_TIMING=1 \
               -DR200_PERF_AUTOREPORT=$(MGLPPC_AUTOREPORT) \
               -DMGLPPC_PROFILE=$(MGLPPC_PROFILE) \
               -DMGLPPC_CLIENT_TRACE=$(MGLPPC_CLIENT_TRACE) \
               -DMGLPPC_CP_SURFACE_SLOTS=$(MGLPPC_CP_SLOTS) \
               -DR200_EXPAND_MISMATCH_MIN=$(MGLPPC_EXPAND_MIN)UL \
               -DR200_STREAM_COMMITS=1 -DR200_ASYNC_ROTATION=1

# MGLPPC_INFLIGHT=1 builds the host with the conservative drain-per-dispatch
# submission model (one outstanding fence), overriding the multi-fence
# pipeline. Diagnostic/A-B builds only. No define is passed otherwise, so
# the source default (MGLPPC_RING_SLOTS) applies.
MGLPPC_INFLIGHT ?= 0
MGLPPC_INFLIGHT_FLAG = $(if $(filter 1,$(MGLPPC_INFLIGHT)),\
	-DMGLPPC_INFLIGHT_SLOTS=1,)

R200_SOURCES = $(R200_LIBRARY)/minigl_r200_warpos_compile_probe.c \
               $(R200_LIBRARY)/r200_unity.c \
               $(R200_LIBRARY)/minigl_r200.c \
               $(R200_LIBRARY)/r200_geometry.c \
               $(R200_LIBRARY)/r200_submit.c \
               $(R200_LIBRARY)/r200_math.c \
               $(R200_LIBRARY)/r200_texture.c \
               $(R200_LIBRARY)/r200_surface.c \
               $(R200_LIBRARY)/r200_state.c \
               $(wildcard $(R200_LIBRARY)/*.h) \
               $(wildcard $(R200_INCLUDE)/libraries/*.h) \
               $(wildcard $(R200_THIRDPARTY)/*.h \
                           $(R200_THIRDPARTY)/*/*.h)

OBJS = $(OBJDIR)/minigl_ppc_dispatch_r200.o \
       $(OBJDIR)/r200_frontend.o \
       $(OBJDIR)/r200_cp_emit.o \
       $(OBJDIR)/radeon3d_emit.o \
       $(OBJDIR)/minigl_ppc_transport.o \
       $(OBJDIR)/minigl_ppc_yield.o \
       $(OBJDIR)/minigl_ppc_serial.o \
       $(OBJDIR)/minigl_ppc_serial_altivec.o \
       $(OBJDIR)/minigl_ppc_serial_vector.o \
        $(OBJDIR)/minigl_warpos_cache_flush.o \
        $(OBJDIR)/minigl_ppc_ring_mmio.o \
        $(OBJDIR)/r200_poweropen_bridge.o \
       $(OBJDIR)/dllstartup.o \
       $(OBJDIR)/dll.o \
       $(OBJDIR)/dllimport.o
DEPS = $(filter %.d,$(OBJS:.o=.d))

.PHONY: all warpelf frontend native-r200 host stack package clean
all: $(OUT)
warpelf: $(WARPELF)
frontend: $(OBJDIR)/r200_frontend.o
native-r200:
	mkdir -p "$(dir $(R200_NATIVE_IMPORTLIB))"
	$(MAKE) -C "$(R200_NATIVE_ROOT)" -f Makefile_dispatch_r200.gcc \
		CC="$(M68K_CC)" AR="$(M68K_PREFIX)ar" NM="$(M68K_PREFIX)nm" \
		OBJDIR="$(R200_NATIVE_OBJDIR)" EXOBJDIR="$(R200_NATIVE_EXOBJDIR)" \
		OUTDIR="$(R200_NATIVE_OUTDIR)" BINDIR="$(R200_NATIVE_BINDIR)" \
		IMPORTLIB="$(R200_NATIVE_IMPORTLIB)" \
		RADEON3D_INC="$(abspath $(R200_THIRDPARTY))" all importlib
host: native-r200 $(R200_HOST)
stack: warpelf host
package: stack $(OUT) lib/libminigl.a backend_r200/README-WarpOS-R200.txt
	mkdir -p $(R200_PACKAGE_DIR)
	cp $(OUT) $(R200_PACKAGE_DIR)/minigl_ppc.dll
	cp $(R200_HOST) $(R200_PACKAGE_DIR)/minigl_ppc_host
	cp $(R200_NATIVE_LIBRARY) $(R200_PACKAGE_DIR)/minigl.library
	cp lib/libminigl.a $(R200_PACKAGE_DIR)/libminigl.a
	cp backend_r200/README-WarpOS-R200.txt $(R200_PACKAGE_DIR)/README.txt
	cd $(R200_PACKAGE_DIR) && sha256sum minigl_ppc.dll minigl_ppc_host \
		minigl.library libminigl.a > SHA256SUMS

$(OBJDIR) $(R200_GENERATED) bin:
	mkdir -p $@

$(OBJDIR)/r200_frontend.o: $(R200_SOURCES) Makefile.dll.r200.gcc Makefile.wos.gcc.common | $(OBJDIR)
	$(CC) $(R200_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/r200_cp_emit.o: $(R200_LIBRARY)/r200_cp_emit.c Makefile.dll.r200.gcc | $(OBJDIR)
	$(CC) $(R200_CFLAGS) -I$(R200_EMITTER_ROOT)/include -MMD -MP -c $< -o $@

$(OBJDIR)/radeon3d_emit.o: $(R200_EMITTER_ROOT)/src/radeon3d_emit.c Makefile.dll.r200.gcc | $(OBJDIR)
	$(CC) $(R200_CFLAGS) -I$(R200_EMITTER_ROOT)/include -MMD -MP -c $< -o $@

$(R200_SYMBOLS): $(OBJDIR)/r200_frontend.o | $(R200_GENERATED)
	$(NM) --defined-only --format=posix $< | \
		awk '$$2 == "T" && $$1 ~ /^Lib_/ { print $$1 }' | sort -u > $@

$(R200_TABLE): include/libraries/minigl_dispatch.h $(R200_SYMBOLS) \
              tools/generate_dispatch_r200.py | $(R200_GENERATED)
	$(PYTHON) tools/generate_dispatch_r200.py \
		include/libraries/minigl_dispatch.h $(R200_SYMBOLS) $@

$(OBJDIR)/minigl_ppc_dispatch_r200.o: ppc_dll/minigl_ppc_dispatch_r200.c \
              include/libraries/minigl_dispatch.h $(R200_TABLE) | $(OBJDIR)
	$(CC) $(DLL_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/minigl_ppc_transport.o: $(R200_CLIENT)/minigl_ppc_transport.c \
              $(R200_INCLUDE)/libraries/minigl_ppc_transport.h \
              $(R200_INCLUDE)/libraries/minigl_ppc_protocol.h | $(OBJDIR)
	$(CC) $(R200_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/minigl_ppc_yield.o: $(R200_CLIENT)/minigl_ppc_yield.c \
              $(R200_INCLUDE)/libraries/minigl_ppc_yield.h | $(OBJDIR)
	$(CC) $(R200_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/minigl_ppc_serial.o: $(R200_CLIENT)/minigl_ppc_serial.s | $(OBJDIR)
	$(CC) $(WOS_ARCH_CFLAGS) -Wa,-mregnames -c $< -o $@

# AltiVec kernel: the assembler needs its own AltiVec enable on top of the
# 604e architecture flags, and GNU as only parses rN/vN names with
# -mregnames. Only the volatile vector registers v0-v4 are touched and
# VRSAVE is saved/restored by the kernel itself.
$(OBJDIR)/minigl_ppc_serial_altivec.o: $(R200_CLIENT)/minigl_ppc_serial_altivec.s | $(OBJDIR)
	$(CC) $(WOS_ARCH_CFLAGS) -Wa,-maltivec,-mregnames -c $< -o $@

$(OBJDIR)/minigl_ppc_serial_vector.o: $(R200_CLIENT)/minigl_ppc_serial_altivec.c \
              $(R200_LIBRARY)/minigl_r200_internal.h | $(OBJDIR)
	$(CC) $(R200_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/minigl_warpos_cache_flush.o: \
              $(R200_CLIENT)/minigl_warpos_cache_flush.s | $(OBJDIR)
	$(CC) $(WOS_ARCH_CFLAGS) -c $< -o $@

$(OBJDIR)/minigl_ppc_ring_mmio.o: \
              $(R200_CLIENT)/minigl_ppc_ring_mmio.s | $(OBJDIR)
	$(CC) $(WOS_ARCH_CFLAGS) -c $< -o $@

$(OBJDIR)/r200_poweropen_bridge.o: $(R200_CLIENT)/r200_poweropen_bridge.s | $(OBJDIR)
	$(CC) $(WOS_ARCH_CFLAGS) -c $< -o $@

$(OBJDIR)/dllstartup.o: hyperion_dll/dllstartup.c | $(OBJDIR)
	$(CC) $(DLL_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/dll.o: hyperion_dll/dll.c | $(OBJDIR)
	$(CC) $(DLL_CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/dllimport.o: hyperion_dll/dllimport.c | $(OBJDIR)
	$(CC) $(DLL_CFLAGS) -MMD -MP -c $< -o $@

$(R200_HOST): $(R200_DIR)/minigl_ppc_host.c \
              tools/check_68k_host.py \
              $(R200_INCLUDE)/libraries/minigl_subimage_timing.h \
              $(R200_INCLUDE)/libraries/minigl_ppc_protocol.h \
              $(R200_INCLUDE)/libraries/minigl_r200_bridge.h \
              $(R200_INCLUDE)/libraries/minigl_ppc_ib_trace.h \
              $(R200_NATIVE_IMPORT) Makefile.dll.r200.gcc | bin
# The host runs on the target 68060 (the R200 backend is 68060-only); build
# it with 68060 scheduling instead of the historical 68020 codegen. The
# native import archive it links is already built with CPU=68060.
	$(M68K_CC) -std=gnu99 -O2 -mcpu=68060 -noixemul -Wall \
		-Werror=incompatible-pointer-types -DMGLPPC_HOST_TRACE=$(MGLPPC_HOST_TRACE) \
		-DMGLPPC_PROFILE=$(MGLPPC_PROFILE) -DMGLPPC_PACING=$(MGLPPC_PACING) \
		-DMGLPPC_IDLE_DIAG=$(MGLPPC_IDLE_DIAG) -DMGLPPC_HOST_DBG=$(MGLPPC_HOST_DBG) \
		$(MGLPPC_INFLIGHT_FLAG) \
		-DMGLPPC_HOST_TARGET_CACHE=$(MGLPPC_HOST_TARGET_CACHE) \
		-I$(R200_INCLUDE) -I$(R200_NATIVE_ROOT)/include \
		-I$(R200_NATIVE_ROOT)/third_party/warp3d/include \
		-I$(R200_THIRDPARTY) $< $(R200_NATIVE_IMPORT) -o $@
	$(PYTHON) tools/check_68k_host.py $@

lib/libminigl.a:
	$(MAKE) -f Makefile.import.gcc importlib

$(WARPELF): $(OBJS) $(WOS_ETREL_LDSCRIPT) | bin
	$(LD) $(WOS_LINK_FLAGS) $(WOS_LIBRARY_DIRS) -o $@ \
		$(WOS_STARTFILE) $(OBJS) $(WOS_RUNTIME_LIBS) $(WOS_ENDFILE)
	$(call WOS_VALIDATE_ETREL,$@)

$(OUT): $(WARPELF)
	@command -v "$(ELF2EXE2)" >/dev/null 2>&1 || \
		{ echo "Elf2Exe2 is target-hosted; build 'warpelf' here and run conversion on Amiga/WarpOS."; exit 127; }
	$(ELF2EXE2) $< $@

clean:
	rm -rf $(OBJDIR) $(OUT) $(WARPELF) $(R200_HOST) \
		$(R200_PACKAGE_DIR) $(R200_SYMBOLS) $(R200_TABLE)

-include $(DEPS)
