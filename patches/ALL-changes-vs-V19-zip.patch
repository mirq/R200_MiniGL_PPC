diff --git a/Makefile.dll.gcc b/Makefile.dll.gcc
index cdab506..5aa447b 100644
--- a/Makefile.dll.gcc
+++ b/Makefile.dll.gcc
@@ -1,20 +1,33 @@
 # WarpOS MiniGL V19 PPC DLL using Hyperion's DLL runtime.
 # The MiniGL implementation is the bundled mglQ3 tree.
-CC      := ppc-amigaos-gcc
+# Toolchain: ppc-morphos-gcc 15.2 + mos2wos "warpup" overlay (docker image
+# ppc-morphos-wos-toolchain), same adaptation as the V10 tree: -warpup ->
+# -DWARPUP --specs=warpup, -lppcamiga (vintage toolchain only) -> -lamigawos
+# (classic amiga.lib helpers CreatePort/DeletePort... used by hyperion_dll).
+CC      := ppc-morphos-gcc
 CPU     ?= 604e
 OBJDIR  ?= obj/dll
 OUT     ?= bin/minigl_ppc.dll
+# Elf2Exe2 is an AmigaOS-native binary and cannot run on the Linux build host;
+# WarpOS's patched loader runs the raw linked PPC ELF directly (hardware-
+# confirmed with the V10 DLL in every port), so this is a no-op by default.
+ELF2EXE2 ?= true
 
 MGLQ3_DIR ?= mglQ3
 MGLQ3_LIB ?= $(MGLQ3_DIR)/lib/libmgl-wos.a
 
-CFLAGS = -warpup -mcpu=$(CPU) -O3 -mmultiple -Wall \
+# include/mgl is the bundled core's own header set (mglQ3/include/mgl copied
+# over the shipped V3D-fork headers, which reference a nonexistent
+# backend/include/v3d_vertex.h). mglQ3/include itself is NOT on the path: its
+# 68k-style proto/, inline/, pragmas/ and Warp3D/ copies would shadow the
+# toolchain's PPC cross-call headers.
+CFLAGS = -DWARPUP --specs=warpup -mcpu=$(CPU) -O3 -mmultiple -Wall \
          -fomit-frame-pointer \
-         -I$(MGLQ3_DIR)/include -Iinclude -Ihyperion_dll
+         -Iinclude -Ihyperion_dll
 
 # Override if the local WarpOS toolchain/backend needs additional libraries.
 MGLQ3_LIBS  ?= -lm
-WARPUP_LIBS ?= -lppcamiga
+WARPUP_LIBS ?= -lamigawos
 
 OBJS = $(OBJDIR)/minigl_ppc_dispatch.o \
        $(OBJDIR)/dllstartup.o \
@@ -46,7 +59,7 @@ $(OBJDIR)/dllimport.o: hyperion_dll/dllimport.c | $(OBJDIR)
 
 $(OUT): $(OBJS) $(MGLQ3_LIB) | bin
 	$(CC) $(CFLAGS) $(OBJS) $(MGLQ3_LIB) $(MGLQ3_LIBS) $(WARPUP_LIBS) -o $@
-	elf2exe2 $@ $@
+	$(ELF2EXE2) $@ $@
 
 clean:
 	rm -rf $(OBJDIR) $(OUT)
