diff --git a/deps_build_minigl_v19.sh b/deps_build_minigl_v19.sh
new file mode 100644
index 0000000..271d5bc
--- /dev/null
+++ b/deps_build_minigl_v19.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+# Build the MiniGL_WOS V19 package with the ppc-morphos-wos-toolchain image:
+#   lib/libminigl_dispatch_ppc.a   (client import archive the ports link)
+#   mglQ3/lib/libmgl-wos.a         (bundled MiniGL core)
+#   bin/minigl_ppc.dll             (the DLL shipped next to every port's ELF)
+#   bin/stub/minigl_ppc.dll        (backend-free diagnostic stub)
+# Run from WSL (via the PowerShell tool):
+#   wsl -d Ubuntu -- bash /mnt/c/Users/mvick/ClaudeCode/MiniGL_WOS/deps_build_minigl_v19.sh [clean]
+set -e
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+LOG="$DIR/build-$(date +%Y%m%d-%H%M%S).log"
+echo "log: $LOG"
+docker run --rm \
+	-v "$DIR":/work \
+	-w /work \
+	ppc-morphos-wos-toolchain:latest \
+	bash -c "
+		set -e
+		if [ \"$1\" = clean ]; then
+			make -f Makefile.import.gcc clean
+			make -f Makefile.dll.gcc clean
+			make -f Makefile.dll.stub.gcc clean
+		fi
+		make -f Makefile.import.gcc importlib
+		make -f Makefile.dll.gcc
+		make -f Makefile.dll.stub.gcc
+		echo '=== outputs ==='
+		ls -la lib/libminigl_dispatch_ppc.a mglQ3/lib/libmgl-wos.a bin/minigl_ppc.dll bin/stub/minigl_ppc.dll
+	" 2>&1 | tee "$LOG"
+rc=${PIPESTATUS[0]}
+echo "build exit: $rc" | tee -a "$LOG"
+echo "errors: $(grep -c 'error:' "$LOG")  warnings: $(grep -c 'warning:' "$LOG")"
+exit $rc
