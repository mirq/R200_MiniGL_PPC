diff --git a/Makefile.import.gcc b/Makefile.import.gcc
index 12b0642..47fecf7 100644
--- a/Makefile.import.gcc
+++ b/Makefile.import.gcc
@@ -1,20 +1,24 @@
 # WarpOS MiniGL V19 direct-dispatch client import library + shared test examples
-CC      := ppc-amigaos-gcc
-AR      := ppc-amigaos-ar
-RANLIB  := ppc-amigaos-ranlib
+# Toolchain: ppc-morphos-gcc 15.2 + mos2wos "warpup" overlay (docker image
+# ppc-morphos-wos-toolchain); see Makefile.dll.gcc for the flag/lib mapping.
+CC      := ppc-morphos-gcc
