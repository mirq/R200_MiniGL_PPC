                 -fomit-frame-pointer -Iinclude -Ihyperion_dll
 CFLAGS    = $(COMMON_CFLAGS)
 EX_CFLAGS = $(COMMON_CFLAGS)
 
-# WarpOS support for Exec/DOS calls made by the examples and Hyperion loader.
-WARPUP_LIBS ?= -lppcamiga
+# Exec/DOS support comes from the warpup specs' default libs (-lcwos
