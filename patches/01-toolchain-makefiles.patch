diff --git a/deps_build_minigl_v19.sh b/deps_build_minigl_v19.sh
new file mode 100644
index 0000000..271d5bc
--- /dev/null
+++ b/deps_build_minigl_v19.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+# Build the MiniGL_WOS V19 package with the ppc-morphos-wos-toolchain image:
+#   lib/libminigl_dispatch_ppc.a   (client import archive the ports link)
+#   mglQ3/lib/libmgl-wos.a         (bundled MiniGL core)
+#   bin/minigl_ppc.dll             (the DLL shipped next to every port's ELF)
+#   bin/stub/minigl_ppc.dll        (backend-free diagnostic stub)
+# Run from WSL (via the PowerShell tool):
+#   wsl -d Ubuntu -- bash /mnt/c/Users/mvick/ClaudeCode/MiniGL_WOS/deps_build_minigl_v19.sh [clean]
+set -e
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+LOG="$DIR/build-$(date +%Y%m%d-%H%M%S).log"
+echo "log: $LOG"
+docker run --rm \
+	-v "$DIR":/work \
+	-w /work \
+	ppc-morphos-wos-toolchain:latest \
+	bash -c "
+		set -e
+		if [ \"$1\" = clean ]; then
+			make -f Makefile.import.gcc clean
+			make -f Makefile.dll.gcc clean
+			make -f Makefile.dll.stub.gcc clean
+		fi
+		make -f Makefile.import.gcc importlib
+		make -f Makefile.dll.gcc
+		make -f Makefile.dll.stub.gcc
+		echo '=== outputs ==='
+		ls -la lib/libminigl_dispatch_ppc.a mglQ3/lib/libmgl-wos.a bin/minigl_ppc.dll bin/stub/minigl_ppc.dll
+	" 2>&1 | tee "$LOG"
+rc=${PIPESTATUS[0]}
+echo "build exit: $rc" | tee -a "$LOG"
+echo "errors: $(grep -c 'error:' "$LOG")  warnings: $(grep -c 'warning:' "$LOG")"
+exit $rc
diff --git a/mglQ3/Makefile.wos.gcc b/mglQ3/Makefile.wos.gcc
index 4fa468b..7a7c6f4 100644
--- a/mglQ3/Makefile.wos.gcc
+++ b/mglQ3/Makefile.wos.gcc
@@ -1,16 +1,26 @@
 # Build the bundled mglQ3 core for WarpOS/PPC with GCC.
-CC      := ppc-amigaos-gcc
-AR      := ppc-amigaos-ar
-RANLIB  := ppc-amigaos-ranlib
+# Toolchain: ppc-morphos-gcc 15.2 + mos2wos "warpup" overlay (docker image
+# ppc-morphos-wos-toolchain). Flags follow the hardware-proven V10 backend
+# build (Makefile.backend.gcc there): -O3, no fast-math (clip/W math), no
+# unwind tables, -DINLINE=__inline. The image's os-includeppc already carries
+# Warp3D/, powerpc/ and the proto/ headers sysinc.h needs; the bundled
+# mglQ3/include (mgl/, pragmas/, clib/, inline/) is searched first.
+CC      := ppc-morphos-gcc
+AR      := ppc-morphos-ar
+RANLIB  := ppc-morphos-ranlib
 
 CPU     ?= 604e
 OBJDIR  ?= obj_wos_gcc
 LIBDIR  ?= lib
 LIBNAME ?= $(LIBDIR)/libmgl-wos.a
 
-CFLAGS = -std=c99 -warpup -mcpu=$(CPU) -O2 -ffast-math -mmultiple \
-         -fomit-frame-pointer -fno-strict-aliasing -fno-strict-overflow \
-         -DNDEBUG -D__PPC__ -Iinclude -Wall -Wextra
+CFLAGS = -DWARPUP --specs=warpup -mcpu=$(CPU) -O3 -mmultiple -Wall \
+         -fomit-frame-pointer -fno-asynchronous-unwind-tables -fno-fast-math \
+         -fno-strict-aliasing -DINLINE=__inline -I../include -Isrc
+# -I../include (the package's public headers, = these mgl/ headers) rather
+# than -Iinclude: mglQ3/include also carries 68k-style proto/, inline/,
+# clib/, pragmas/ and Warp3D/ copies that would shadow the toolchain's PPC
+# cross-call headers (Warp3D, cybergraphics) with #pragma libcall stubs.
 
 SOURCES = src/context.c src/init.c src/fog.c src/texture.c src/others.c \
           src/matrix.c src/vertexbuffer.c src/hclip.c src/draw.c src/aclip.c \
diff --git a/probe_dll_symbols.sh b/probe_dll_symbols.sh
new file mode 100644
index 0000000..52fa819
--- /dev/null
+++ b/probe_dll_symbols.sh
@@ -0,0 +1,10 @@
+#!/bin/bash
+# Sanity check of the built V19 artifacts: exported bootstrap symbols, the V19
+# dispatch tail, and no unexpected undefined symbols in the DLL.
+docker run --rm -v /mnt/c/Users/mvick/ClaudeCode/MiniGL_WOS:/work -w /work ppc-morphos-wos-toolchain:latest bash -c '
+NM=/opt/ppc-morphos/bin/ppc-morphos-nm
+echo "=== DLL: bootstrap + tail ==="; $NM bin/minigl_ppc.dll | grep -E " [TtDd] (MGLGetDispatchTable|dllFindResource|dllLoadResource|dllFreeResource|PPC_GLMultiDrawArrays|PPC_MGLGetInputWindowHandle|GLInterleavedArrays|MGLEmergencyCloseScreen|MGLCreateContext|GLBegin)$"
+echo "=== DLL: undefined ==="; $NM bin/minigl_ppc.dll | grep " U " | head
+echo "=== import lib exports ==="; $NM lib/libminigl_dispatch_ppc.a | grep -E " [TDB] (MiniGLOpen|MiniGLClose|MiniGLDispatch|MiniGLBase)$"
+echo "=== core lib: a few ==="; $NM mglQ3/lib/libmgl-wos.a | grep -E " T (GLTexImage2D|GLDrawElements|GLLockArrays|MGLSetPointer|MGLMainLoop)$"
+'
