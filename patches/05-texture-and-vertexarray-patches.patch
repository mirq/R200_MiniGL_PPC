+		target += iw * ih * BytesPerTexel;
+		if (iw > 1) iw /= 2;
+		if (ih > 1) ih /= 2;
+	}
+	if ((ULONG)width != iw || (ULONG)height != ih)
+		return;
+
+	MGLConvert(context, pixels, (UWORD *)target, width, height, internalformat, format);
+	W3D_UpdateTexImage(context->w3dContext, tex, target, level, NULL);
