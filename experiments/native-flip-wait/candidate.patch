+    assert(c->displayTimerPending && r->io_Command == TR_ADDREQUEST);
+    assert(!r->io_Error && !r->io_Flags);
+    assert(c->displayTimerRequest.tr_time.tv_secs == 2);
+    assert(c->displayTimerRequest.tr_time.tv_micro == 0);
