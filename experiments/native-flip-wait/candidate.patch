+static BOOL OpenDisplayWaitTimer(struct MiniGLR200Context *context)
+{
+    struct IORequest *request = &context->displayTimerRequest.tr_node;
+
+    context->displayTimerPort = CreateMsgPort();
+    if (!context->displayTimerPort)
+        return FALSE;
+    request->io_Message.mn_Node.ln_Type = NT_MESSAGE;
+    request->io_Message.mn_ReplyPort = context->displayTimerPort;
+    request->io_Message.mn_Length = sizeof(context->displayTimerRequest);
+    if (OpenDevice((CONST_STRPTR)TIMERNAME, UNIT_MICROHZ, request, 0))
+        return FALSE;
+    context->displayTimerOpen = TRUE;
+    return TRUE;
+}
+
+static LONG ReapDisplayWaitTimer(struct MiniGLR200Context *context)
+{
+    struct IORequest *request = &context->displayTimerRequest.tr_node;
+    LONG error;
+
+    if (!context->displayTimerPending)
+        return 0;
+    if (!CheckIO(request))
+        AbortIO(request);
+    error = WaitIO(request);
+    context->displayTimerPending = FALSE;
+    return error;
+}
+
+void CloseDisplayWaitTimer(struct MiniGLR200Context *context)
+{
+    (void)ReapDisplayWaitTimer(context);
+    if (context->displayTimerOpen) {
+        CloseDevice(&context->displayTimerRequest.tr_node);
+        context->displayTimerOpen = FALSE;
+    }
+    if (context->displayTimerPort) {
+        DeleteMsgPort(context->displayTimerPort);
+        context->displayTimerPort = NULL;
+    }
+}
