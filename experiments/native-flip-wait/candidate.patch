+        context->displayTimerPort->mp_SigTask != task ||
+        context->safePort->mp_Flags != PA_SIGNAL ||
+        context->displayPort->mp_Flags != PA_SIGNAL ||
+        context->displayTimerPort->mp_Flags != PA_SIGNAL ||
+        context->safePort->mp_SigBit >= 32 ||
+        context->displayPort->mp_SigBit >= 32 ||
+        context->displayTimerPort->mp_SigBit >= 32 ||
+        context->displayTimerPending)
