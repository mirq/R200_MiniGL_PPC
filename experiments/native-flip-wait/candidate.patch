index 0000000..4653390
--- /dev/null
+++ b/tests/test_r200_display_wait.py
@@ -0,0 +1,927 @@
+"""CPU-only display wait regression: python3 tests/test_r200_display_wait.py.
+
+Compile unchanged production functions against deterministic Exec/Intuition
+queues and a virtual timer. No SDK, Amiga, GPU, or real-time sleeps are used.
+Destroy/delete/task-close, the public delete wrapper, expunge guard, and native
+flip path run with narrow context/resource stubs. Submission internals,
+rendering, performance accounting, and target ABI are not tested.
+Generated C and the ASan/UBSan executable live only in /tmp/opencode.
+"""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[1]
+LIBRARY = ROOT / "classic_68k/dev/MiniGL_Library_Source_Code/library"
+
+
+def extract(filename, signature):
+    text = (LIBRARY / filename).read_text()
+    match = re.search(rf"^{re.escape(signature)}[^;{{}}]*\{{", text, re.MULTILINE)
+    assert match, f"Missing function definition: {filename}: {signature}"
+    start, opening = match.start(), match.end() - 1
+    depth = 0
+    # Ignore braces in strings/comments, but return the original bytes intact.
+    tokens = r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|[{}]'
+    for token in re.finditer(tokens, text[opening:], re.DOTALL):
+        if token.group() == "{":
+            depth += 1
+        elif token.group() == "}":
+            depth -= 1
+            if depth == 0:
+                line = text.count("\n", 0, start) + 1
+                return (f'\n#line {line} "{filename}"\n'
+                        + text[start:opening + token.end()] + "\n")
+    raise AssertionError(f"Unterminated function: {signature}")
+
+
+code = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint32_t ULONG, GLenum, BPTR;
+typedef int32_t LONG;
+typedef int BOOL;
+typedef unsigned char UBYTE;
+typedef const char *CONST_STRPTR;
+typedef struct GLcontext_t *GLcontext;
+#define TRUE 1
+#define FALSE 0
+#define R200_PPC_FRONTEND 0
+#define MINIGL_BACKEND_R200 1
+#define MINIGL_REGARG(reg, type, name) type name
+#define LIBF_DELEXP 8
+#define PA_SIGNAL 0
+#define PA_IGNORE 2
+#define NT_MESSAGE 5
+#define IOERR_ABORTED (-2)
+#define TR_ADDREQUEST 9
+#define TIMERNAME "timer.device"
+#define UNIT_MICROHZ 0
+enum { SAFE_BIT = 3, DISPLAY_BIT = 11, TIMER_BIT = 29, OTHER_BIT = 17 };
+#define BIT(n) (UINT32_C(1) << (n))
+#define WAIT_MASK (BIT(SAFE_BIT) | BIT(DISPLAY_BIT) | BIT(TIMER_BIT))
+struct Task { BOOL alive; };
+struct ExecBase { struct Task *ThisTask; };
+struct SignalSemaphore { BOOL held; };
+struct Node { int unused; };
+struct Library { ULONG lib_OpenCnt, lib_Flags, lib_NegSize, lib_PosSize; };
+struct MiniGLLibrary { struct Library lib; BPTR segList; };
+struct MsgPort;
+struct Message {
+    struct { unsigned char ln_Type; } mn_Node;
+    struct MsgPort *mn_ReplyPort;
+    unsigned short mn_Length;
+    struct Message *next;
+    BOOL queued;
+};
+struct MsgPort {
+    struct Task *mp_SigTask;
+    unsigned char mp_SigBit, mp_Flags;
+    struct Message *head, *tail;
+};
+struct IORequest {
+    struct Message io_Message;
+    unsigned short io_Command;
+    unsigned char io_Flags;
+    signed char io_Error;
+};
+typedef struct {
+    struct IORequest tr_node;
+    struct { ULONG tv_secs, tv_micro; } tr_time;
+} TimeRequest_Type;
+struct DBufInfo { struct Message dbi_SafeMessage, dbi_DispMessage; };
+struct BitMap { int id; };
+struct ScreenBuffer { struct DBufInfo *sb_DBufInfo; struct BitMap *sb_BitMap; };
+struct BufferStorage {
+    struct ScreenBuffer buffer;
+    struct DBufInfo info;
+    struct BitMap bitmap;
+};
+struct RastPort { struct BitMap *BitMap; };
+struct Screen { struct RastPort RastPort; };
+struct Window { struct RastPort *RPort; LONG BorderLeft, BorderTop; };
+struct Radeon3DSurface { void *Handle; };
+struct Vertex { float x, y; };
+struct TextureDirtyRect { ULONG left, right; };
+struct FastPath { void *privateData, *currentVertex; };
+'''
+for filename, names in (
+    ("minigl_r200_internal.h", ("R200_SCREEN_BUFFERS", "MAX_TEXTURES")),
+    ("minigl_r200.h", ("GL_NO_ERROR", "GL_INVALID_OPERATION", "GL_FRONT", "GL_BACK")),
+):
+    header = (LIBRARY / filename).read_text()
+    for name in names:
+        match = re.search(rf"^#define {name} .+$", header, re.MULTILINE)
+        assert match, f"Missing production constant: {name}"
+        code += match.group() + "\n"
+code += r'''
+struct MiniGLR200Context {
+    struct ScreenBuffer *screenBuffers[R200_SCREEN_BUFFERS];
+    struct MsgPort *safePort, *displayPort, *displayTimerPort;
+    TimeRequest_Type displayTimerRequest;
+    ULONG displayTimerOpen, displayTimerPending, displayWaitFailed;
+    ULONG bufferSafe, bufferDisplayed, displayedBuffer, pendingBuffer;
+    ULONG drawingBuffer, screenBufferCount, pendingValid;
+    ULONG fullscreen, screenOwned, screenLocked, singleBuffer, syncEnabled;
+    ULONG drawBuffer, error, insideBegin, presentFlip, presentBlit;
+    struct Screen *screen;
+    struct Window *window;
+    struct RastPort source;
+    ULONG width, height, perfEnabled;
+    struct { ULONG executeTicks, waitTicks, presentTicks; } perf;
+    struct Radeon3DSurface surfaces[R200_SCREEN_BUFFERS], depthSurface;
+    ULONG captureCacheValid, pendingDrawValid;
+    struct { ULONG header[3]; } captureCache, pendingDraw;
+    struct FastPath *activeFastPath;
+    void *fastBuffer, *lockedVertices, *indexCacheVerts, *indexCacheStamp;
+    ULONG fastBufferBytes, lockedCount, indexCacheSize;
+    void *device;
+    struct BitMap *bitmap, *depthBitmap;
+    struct {
+        struct Radeon3DSurface surface;
+        struct BitMap *bitmap;
+        void *image, *dirtyRects;
+        ULONG imageBytes, levelCount;
+    } textures[MAX_TEXTURES];
+    ULONG segmentLeaseCount;
+    struct { ULONG id; } segmentLeases[2];
+};
+static struct MiniGLR200Context *c;
+static struct Task owner, foreign;
+static struct ExecBase execBase = {&owner}, *SysBase = &execBase;
+static struct MiniGLR200Base {
+    struct SignalSemaphore lock;
+    struct Task *owner;
+    struct MiniGLR200Context *context;
+} backend, *LibraryBase = &backend;
+static GLcontext mini_CurrentContext;
+static struct Library *DOSBase;
+static BOOL MiniGLInitialized = TRUE;
+static ULONG handles[R200_SCREEN_BUFFERS + 2];
+static struct FastPath fastPath;
+static struct { void *p; size_t size; } allocations[64];
+static unsigned allocated, freed, live;
+static unsigned portCreates, portDeletes, opens, closes, sends, aborts, reaps;
+static unsigned checks, waits, signalClears, dequeued, changes, changeCalls, tofs;
+static unsigned flushes, submits, drains, deferred, released, freedBuffers;
+static unsigned cleanupCalls;
+static unsigned lockEntries, preclearChecks, disables, enables, windowCloses;
+static unsigned signalDeliveries, semanticBumps;
+static BOOL expectPreclear, interruptsDisabled;
+static BOOL failPort, failOpen, flushOK, submitOK, drainOK, abortRace;
+static struct IORequest *opened, *outstanding;
+static BOOL ioDone;
+static LONG completionError;
+static uint64_t now, deadline;
+static ULONG signals, failures, autoReplies, submittedBuffer;
+enum { SAFE = 1, DISPLAY = 2, BOTH = 3, FOREIGN = 4, SPURIOUS = 8 };
+struct Event { uint64_t at; ULONG buffer, replies; };
+static struct Event events[64];
+static unsigned eventCount, eventNext;
+static struct Message foreignSafe, foreignDisplay;
+static ULONG armReplies;
+
+static void *allocate(size_t size) {
+    assert(allocated < 64);
+    void *p = calloc(1, size);
+    assert(p);
+    allocations[allocated].p = p;
+    allocations[allocated++].size = size;
+    ++live;
+    return p;
+}
+static void release(void *p, size_t size) {
+    for (unsigned i = 0; i < allocated; ++i) {
+        if (allocations[i].p == p) {
+            assert(p && size == allocations[i].size);
+            allocations[i].p = NULL;
+            free(p); ++freed; --live;
+            return;
+        }
+    }
+    assert(!"free of unowned storage");
+}
+static struct Task *FindTask(CONST_STRPTR name) { assert(!name); return SysBase->ThisTask; }
+static void ObtainSemaphore(struct SignalSemaphore *s) {
+    assert(s == &backend.lock && !s->held && !interruptsDisabled);
+    if (expectPreclear) { assert(!mini_CurrentContext); ++preclearChecks; }
+    s->held = TRUE; ++lockEntries;
+}
+static void ReleaseSemaphore(struct SignalSemaphore *s) {
+    assert(s == &backend.lock && s->held && !interruptsDisabled); s->held = FALSE;
+}
+static void Disable(void) {
+    assert(backend.lock.held && !interruptsDisabled && backend.owner == SysBase->ThisTask);
+    assert(!opened && !outstanding && !c->window && !c->displayTimerPort);
+    assert(!c->safePort || (c->safePort->mp_Flags == PA_SIGNAL && c->safePort->mp_SigTask == &owner));
+    assert(!c->displayPort || (c->displayPort->mp_Flags == PA_SIGNAL && c->displayPort->mp_SigTask == &owner));
+    interruptsDisabled = TRUE; ++disables;
+}
+static void Enable(void) {
+    assert(interruptsDisabled && backend.lock.held);
+    assert(!c->safePort || (c->safePort->mp_Flags == PA_IGNORE && !c->safePort->mp_SigTask));
+    assert(!c->displayPort || (c->displayPort->mp_Flags == PA_IGNORE && !c->displayPort->mp_SigTask));
+    interruptsDisabled = FALSE; ++enables;
+}
+static struct MsgPort *port(ULONG bit) {
+    struct MsgPort *p = allocate(sizeof(*p));
+    p->mp_SigTask = &owner; p->mp_SigBit = bit; p->mp_Flags = PA_SIGNAL;
+    return p;
+}
+static struct MsgPort *CreateMsgPort(void) {
+    ++portCreates; return failPort ? NULL : port(TIMER_BIT);
+}
+static void enqueue(struct MsgPort *p, struct Message *m) {
+    assert(p && m && !m->queued);
+    m->queued = TRUE; m->next = NULL;
+    if (p->tail) p->tail->next = m; else p->head = m;
+    p->tail = m;
+    if (p->mp_Flags == PA_SIGNAL) {
+        assert(p->mp_SigTask && p->mp_SigTask->alive);
+        ++signalDeliveries;
+        if (p->mp_SigTask == &owner) signals |= BIT(p->mp_SigBit);
+    } else assert(p->mp_Flags == PA_IGNORE);
+}
+static struct Message *GetMsg(struct MsgPort *p) {
+    assert(p);
+    struct Message *m = p->head;
+    if (m) {
+        assert(m->queued); p->head = m->next;
+        if (!p->head) p->tail = NULL;
+        m->queued = FALSE; m->next = NULL; ++dequeued;
+    }
+    return m;
+}
+static void DeleteMsgPort(struct MsgPort *p) {
+    assert(p && !p->head && !p->tail);
+    assert(!opened || opened->io_Message.mn_ReplyPort != p);
+    assert(!outstanding || outstanding->io_Message.mn_ReplyPort != p);
+    ++portDeletes; release(p, sizeof(*p));
+}
+static LONG OpenDevice(CONST_STRPTR name, ULONG unit, struct IORequest *r, ULONG flags) {
+    assert(!strcmp(name, TIMERNAME) && unit == UNIT_MICROHZ && !flags && !opened);
+    assert(r == &c->displayTimerRequest.tr_node && !outstanding);
+    assert(r->io_Message.mn_Node.ln_Type == NT_MESSAGE);
+    assert(r->io_Message.mn_Length == sizeof(TimeRequest_Type));
+    assert(r->io_Message.mn_ReplyPort == c->displayTimerPort);
+    ++opens; if (failOpen) return -1; opened = r; return 0;
+}
+static void CloseDevice(struct IORequest *r) {
+    assert(r == opened && !outstanding && !r->io_Message.queued);
+    ++closes; opened = NULL;
+}
+static void notify(ULONG buffer, ULONG replies) {
+    if (replies & SPURIOUS) signals |= BIT(SAFE_BIT) | BIT(DISPLAY_BIT);
+    if (replies & FOREIGN) {
+        enqueue(c->safePort, &foreignSafe); enqueue(c->displayPort, &foreignDisplay);
+        signals |= BIT(OTHER_BIT);
+    }
+    if (replies & BOTH) {
+        assert(buffer < R200_SCREEN_BUFFERS && c->screenBuffers[buffer]);
+        struct DBufInfo *d = c->screenBuffers[buffer]->sb_DBufInfo;
+        if (replies & SAFE) enqueue(d->dbi_SafeMessage.mn_ReplyPort, &d->dbi_SafeMessage);
+        if (replies & DISPLAY) enqueue(d->dbi_DispMessage.mn_ReplyPort, &d->dbi_DispMessage);
+    }
+}
+static void schedule(uint64_t at, ULONG buffer, ULONG replies) {
+    assert(eventCount < 64 && at >= now);
+    assert(!eventCount || at >= events[eventCount - 1].at);
+    events[eventCount++] = (struct Event){at, buffer, replies};
+}
+static void finishIO(LONG error) {
+    assert(outstanding && !ioDone);
+    ioDone = TRUE; outstanding->io_Error = error;
+    enqueue(outstanding->io_Message.mn_ReplyPort, &outstanding->io_Message);
+}
+static ULONG SetSignal(ULONG value, ULONG mask) {
+    assert(value == 0 && mask == BIT(TIMER_BIT));
