+static ULONG Wait(ULONG mask) {
+    assert(mask == WAIT_MASK && SysBase->ThisTask == &owner && outstanding && !ioDone);
+    assert(!interruptsDisabled);
+    assert(++waits < 64);
+    if (!(signals & mask)) {
+        now = eventNext < eventCount && events[eventNext].at < deadline
+                  ? events[eventNext].at : deadline;
+        while (eventNext < eventCount && events[eventNext].at <= now) {
+            struct Event e = events[eventNext++]; notify(e.buffer, e.replies);
+        }
