      Run >NIL: Execute Work:ibdraw/hostrun
      Delay 150
      Skip >run_30
   EndIf
      Echo "   * SETUP FAILED - see log; cleaning orphan host *"
      Work:ibdraw/hoststop --orphan >NIL:
EndIf
Type Work:ibdraw/regress/quake.pickup-flash.log
If "$mode" EQ "MANUAL"
   Ask "    Accept this result? (y/n)"
   If WARN
      Ask "    Run this test again? (y/n)"
      If WARN
         Ask "    Finish testing (skip all remaining)? (y/n)"
         If WARN
            Set stop "1"
            Echo "    REJECTED - moving to next test*N"
         Else
            Echo "    FINISH chosen - skipping remaining tests*N"
         EndIf
      Else
         Set retried "1"
         Delay 50
         Run >NIL: Execute Work:ibdraw/hostrun
         Delay 150
         Skip >run_30
      EndIf
   Else
      Echo "    accepted.*N"
   EndIf
EndIf

; --- 31/31 present.stability ---
If "$stop" EQ "1" Skip >end
Set cur "present.stability"
Set retried ""
Echo "*N=== 31/31: present.stability ==="
If "$mode" EQ "MANUAL" Echo "YOU WILL SEE: Draw and present one identical frame repeatedly and check the result never drifts.*NStarting in 3 s..."
If "$mode" EQ "MANUAL" Delay 150
Delay 40
Run >NIL: Execute Work:ibdraw/hostrun
Delay 150
Lab run_31
mgltestsuite --test present.stability --fullscreen --width 640 --height 480 --depth 16 --frames $frames >Work:ibdraw/regress/present.stability.log
If ERROR
   If "$retried" EQ ""
      Echo "   * setup error - fresh host, retrying once *"
      Set retried "1"
      Delay 50
      Run >NIL: Execute Work:ibdraw/hostrun
      Delay 150
      Skip >run_31
   EndIf
      Echo "   * SETUP FAILED - see log; cleaning orphan host *"
      Work:ibdraw/hoststop --orphan >NIL:
EndIf
Type Work:ibdraw/regress/present.stability.log
If "$mode" EQ "MANUAL"
   Ask "    Accept this result? (y/n)"
   If WARN
      Ask "    Run this test again? (y/n)"
      If WARN
         Ask "    Finish testing (skip all remaining)? (y/n)"
         If WARN
            Set stop "1"
            Echo "    REJECTED - moving to next test*N"
         Else
            Echo "    FINISH chosen - skipping remaining tests*N"
         EndIf
      Else
         Set retried "1"
         Delay 50
         Run >NIL: Execute Work:ibdraw/hostrun
         Delay 150
         Skip >run_31
      EndIf
   Else
      Echo "    accepted.*N"
   EndIf
EndIf

Lab end
Echo "*N===== Regression run complete ====="
Echo "Logs: Work:ibdraw/regress/ (one per test)"
Echo "Machine-readable records: Type T:minigl-testsuite.log"
List Work:ibdraw/regress FILES
