; MiniGL quick regression package (AmigaDOS)
; Usage:  Execute Work:ibdraw/regress AUTO    - all tests, no questions
;         Execute Work:ibdraw/regress MANUAL - briefed, then Accept/Re-run/Finish/Reject
; Optional 2nd arg: frames per test (default 60 auto, 600 manual)
; Requires: Work:ibdraw/mgltestsuite + hostrun + hoststop deployed.
; Each test gets a fresh 68k host; logs land in Work:ibdraw/regress/.
; The shell is left in Work:ibdraw afterwards.

FailAt 21
If NOT EXISTS Work:ibdraw/mgltestsuite
   Echo "Work:ibdraw/mgltestsuite missing - deploy the suite first."
   Quit
EndIf
Set mode "$1"
If "$mode" EQ "" Set mode "AUTO"
Set frames "60"
If "$mode" EQ "MANUAL" Set frames "600"
Set ovf "$2"
If "$ovf" NE "" Set frames "$ovf"
Set stop ""
Echo "*NMiniGL regression - mode=$mode frames=$frames*N"
Delete >NIL: Work:ibdraw/regress ALL QUIET
makedir >NIL: Work:ibdraw/regress
CD Work:ibdraw
; clear any orphan host from a previous crashed session
Work:ibdraw/hoststop --orphan >NIL:

; --- 1/31 system.dispatch ---
If "$stop" EQ "1" Skip >end
Set cur "system.dispatch"
Set retried ""
Echo "*N=== 1/31: system.dispatch ==="
If "$mode" EQ "MANUAL" Echo "YOU WILL SEE: Validate ABI version, table size, and runtime dispatch table.*NStarting in 3 s..."
If "$mode" EQ "MANUAL" Delay 150
Delay 40
Run >NIL: Execute Work:ibdraw/hostrun
Delay 150
Lab run_1
mgltestsuite --test system.dispatch --fullscreen --width 640 --height 480 --depth 16 --frames $frames >Work:ibdraw/regress/system.dispatch.log
If ERROR
   If "$retried" EQ ""
      Echo "   * setup error - fresh host, retrying once *"
      Set retried "1"
      Delay 50
      Run >NIL: Execute Work:ibdraw/hostrun
      Delay 150
      Skip >run_1
   EndIf
      Echo "   * SETUP FAILED - see log; cleaning orphan host *"
      Work:ibdraw/hoststop --orphan >NIL:
EndIf
Type Work:ibdraw/regress/system.dispatch.log
If "$mode" EQ "MANUAL"
   Ask "    Accept this result? (y/n)"
   If WARN
      Ask "    Run this test again? (y/n)"
      If WARN
         Ask "    Finish testing (skip all remaining)? (y/n)"
         If WARN
            Set stop "1"
            Echo "    REJECTED - moving to next test*N"
         Else
            Echo "    FINISH chosen - skipping remaining tests*N"
         EndIf
      Else
         Set retried "1"
         Delay 50
         Run >NIL: Execute Work:ibdraw/hostrun
         Delay 150
         Skip >run_1
      EndIf
   Else
      Echo "    accepted.*N"
   EndIf
EndIf

; --- 2/31 primitives.triangle ---
If "$stop" EQ "1" Skip >end
Set cur "primitives.triangle"
Set retried ""
Echo "*N=== 2/31: primitives.triangle ==="
If "$mode" EQ "MANUAL" Echo "YOU WILL SEE: Draw and sample a solid immediate-mode triangle.*NStarting in 3 s..."
If "$mode" EQ "MANUAL" Delay 150
Delay 40
Run >NIL: Execute Work:ibdraw/hostrun
Delay 150
Lab run_2
mgltestsuite --test primitives.triangle --fullscreen --width 640 --height 480 --depth 16 --frames $frames >Work:ibdraw/regress/primitives.triangle.log
If ERROR
   If "$retried" EQ ""
      Echo "   * setup error - fresh host, retrying once *"
      Set retried "1"
      Delay 50
      Run >NIL: Execute Work:ibdraw/hostrun
      Delay 150
      Skip >run_2
   EndIf
      Echo "   * SETUP FAILED - see log; cleaning orphan host *"
      Work:ibdraw/hoststop --orphan >NIL:
EndIf
Type Work:ibdraw/regress/primitives.triangle.log
If "$mode" EQ "MANUAL"
   Ask "    Accept this result? (y/n)"
   If WARN
      Ask "    Run this test again? (y/n)"
      If WARN
         Ask "    Finish testing (skip all remaining)? (y/n)"
         If WARN
            Set stop "1"
            Echo "    REJECTED - moving to next test*N"
         Else
            Echo "    FINISH chosen - skipping remaining tests*N"
         EndIf
      Else
         Set retried "1"
         Delay 50
         Run >NIL: Execute Work:ibdraw/hostrun
         Delay 150
         Skip >run_2
      EndIf
   Else
      Echo "    accepted.*N"
   EndIf
EndIf

