# WarpOS MiniGL V19 direct-dispatch client import library + shared test examples
.DELETE_ON_ERROR:
CPU       ?= 604e
include Makefile.wos.gcc.common

OBJDIR    ?= obj/import
EXOBJDIR  ?= $(OBJDIR)/examples
BINDIR    ?= bin/examples
OUTLIB    ?= lib/libminigl_dispatch_ppc.a
DROPINLIB ?= lib/libminigl.a
# Use separate EXOBJDIR/BINDIR for each value; make does not track flag changes.
MGL_GEARS_PROFILE ?= 0

COMMON_CFLAGS = $(WOS_ARCH_CFLAGS) -O2 -Wall -fomit-frame-pointer \
                 -Iinclude -Ihyperion_dll $(WOS_CPPFLAGS)
CFLAGS    = $(COMMON_CFLAGS)
EX_CFLAGS = $(COMMON_CFLAGS)

OBJS = $(OBJDIR)/minigl_ppc_base.o \
       $(OBJDIR)/minigl_ppc_open.o \
       $(OBJDIR)/dll.o
DEPS = $(OBJS:.o=.d)
EXAMPLE_NAMES = library_test milestone_ballonly_library \
                 milestone_bounce_interactive_library \
                 milestone_gears_stats_library milestone_gears_precalc r200_legacy_smoke \
                 r200_texture_upload_smoke r200_triangle_smoke warp_library \
                  r200_mapping_bench r200_texture_update_test r200_bind_bench r200_ib_smoke \
                  r200_defect_probe minigl_testsuite
EXAMPLE_OBJS = $(addprefix $(EXOBJDIR)/,$(addsuffix .o,$(EXAMPLE_NAMES)))
EXAMPLE_DEPS = $(EXAMPLE_OBJS:.o=.d)
EXAMPLE_WARPELFS = $(addprefix $(BINDIR)/,$(addsuffix _ppc.warpelf,$(EXAMPLE_NAMES)))

.PHONY: all importlib testprograms clean
.SECONDARY: $(EXAMPLE_OBJS)
all: importlib
importlib: $(OUTLIB) $(DROPINLIB)

$(OBJDIR) $(EXOBJDIR) lib $(BINDIR):
	mkdir -p $@

$(OBJDIR)/minigl_ppc_base.o: client/minigl_ppc_base.c Makefile.wos.gcc.common | $(OBJDIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/minigl_ppc_open.o: client/minigl_ppc_open.c Makefile.wos.gcc.common | $(OBJDIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJDIR)/dll.o: hyperion_dll/dll.c Makefile.wos.gcc.common | $(OBJDIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OUTLIB): $(OBJS) | lib
	$(AR) rcs $@ $(OBJS)
	-$(RANLIB) $@

$(DROPINLIB): $(OUTLIB) | lib
	cp $< $@

# Linux can produce the complete WarpOS ELF but cannot run target-hosted
# Elf2Exe2. These files exercise the public headers and import archive and are
# ready for conversion on Amiga/WarpOS, just like the DLL's warpelf target.
testprograms: importlib $(EXAMPLE_WARPELFS)

.PHONY: gears-benchmarks
gears-benchmarks: $(BINDIR)/milestone_gears_stats_library_ppc.warpelf \
                  $(BINDIR)/milestone_gears_precalc_ppc.warpelf

$(EXOBJDIR)/milestone_gears_stats_library.o $(EXOBJDIR)/milestone_gears_precalc.o: EX_CFLAGS += -DMGL_GEARS_PROFILE=$(MGL_GEARS_PROFILE)

$(EXOBJDIR)/milestone_gears_precalc.o: examples/milestone_gears_stats_library.c Makefile.import.gcc Makefile.wos.gcc.common | $(EXOBJDIR)
	$(CC) $(EX_CFLAGS) -DMGL_GEARS_PRECALC=1 -MMD -MP -c $< -o $@

# Standalone protocol client: no MiniGL dispatch archive or driver linkage.
$(EXOBJDIR)/r200_mapping_bench.o: EX_CFLAGS += -Ibackend_r200/include

# Suite reads the R200 opt-in perf counters (no-op on non-R200 backends).
$(EXOBJDIR)/minigl_testsuite.o: EX_CFLAGS += -Ibackend_r200/include

$(EXOBJDIR)/mapping_bench_transport.o: backend_r200/client/minigl_ppc_transport.c Makefile.wos.gcc.common | $(EXOBJDIR)
	$(CC) $(COMMON_CFLAGS) -Ibackend_r200/include -MMD -MP -c $< -o $@

$(BINDIR)/r200_mapping_bench_ppc.warpelf: $(EXOBJDIR)/r200_mapping_bench.o $(EXOBJDIR)/mapping_bench_transport.o $(WOS_ETREL_LDSCRIPT) | $(BINDIR)
	$(LD) $(WOS_LINK_FLAGS) $(WOS_LIBRARY_DIRS) -o $@ \
		$(WOS_STARTFILE) $(EXOBJDIR)/r200_mapping_bench.o \
		$(EXOBJDIR)/mapping_bench_transport.o $(WOS_RUNTIME_LIBS) $(WOS_ENDFILE)
	$(call WOS_VALIDATE_ETREL,$@)

$(EXOBJDIR)/%.o: examples/%.c Makefile.wos.gcc.common | $(EXOBJDIR)
	$(CC) $(EX_CFLAGS) -MMD -MP -c $< -o $@

$(BINDIR)/%_ppc.warpelf: $(EXOBJDIR)/%.o $(OUTLIB) $(WOS_ETREL_LDSCRIPT) | $(BINDIR)
	$(LD) $(WOS_LINK_FLAGS) $(WOS_LIBRARY_DIRS) -o $@ \
		$(WOS_STARTFILE) $< $(OUTLIB) $(WOS_RUNTIME_LIBS) $(WOS_ENDFILE)
	$(call WOS_VALIDATE_ETREL,$@)

clean:
	rm -rf $(OBJDIR) $(BINDIR) $(OUTLIB) $(DROPINLIB)

-include $(DEPS) $(EXAMPLE_DEPS) $(EXOBJDIR)/mapping_bench_transport.d
